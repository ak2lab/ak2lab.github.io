<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#05070b">
    <title>制作事例と技術 | AK²Lab</title>
    <meta name="description" content="AK²LabのWebサイト・Webアプリ・業務システムの制作事例と技術資料。">
    <link rel="icon" href="/assets/logo.png">
    <link rel="preload" href="/assets/fonts/geist.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/assets/site.css">
    <script>document.documentElement.classList.add('js');</script>
    <script src="/assets/site.js" defer></script>
    <script src="/assets/hero.js" type="module"></script>
  </head>
  <body>
    <svg class="sprite" aria-hidden="true">
      <symbol id="logo-mark" viewBox="{{ logo.viewBox }}">
        <path fill-rule="evenodd" d="{{ logo.outline }}"/>
      </symbol>
    </svg>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="header" data-header>
      <div class="frame header-inner">
        <a class="brand" href="/">
          <svg class="brand-mark" aria-hidden="true"><use href="#logo-mark"/></svg>
          <span>AK²Lab</span>
        </a>
        <nav class="nav" aria-label="主なページ">
          <a href="/#works">制作事例</a>
          <a href="https://github.com/ak2lab">GitHub</a>
          <a href="https://ak2lab.com/">公式サイト</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-stage" aria-hidden="true">
          <canvas class="hero-canvas"></canvas>
        </div>
        <div class="frame hero-grid">
          <div class="hero-copy">
            <p class="intro" data-type>Webサイト・Webアプリ・業務システム</p>
            <h1 id="hero-title">
              <span class="line"><span>画面から仕組みまで</span></span>
              <span class="line"><span>作って、確かめる</span></span>
            </h1>
            <p class="lead">使う人の画面と、その奥で動く仕組み。AK²Labが制作したWebサイトやアプリを、技術と設計の視点から紹介します。</p>
            <a class="cta" href="#works" data-magnetic>
              <span class="cta-label">制作事例を見る</span>
              <span class="cta-arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <div class="hero-visual" aria-hidden="true">
            <svg class="blueprint" viewBox="{{ logo.viewBox }}">
              {% for d in logo.parts %}
              <path d="{{ d }}" pathLength="1" style="--i: {{ loop.index0 }}"/>
              {% endfor %}
            </svg>
          </div>
        </div>
        <div class="frame hero-foot">
          <button class="control" type="button" data-scatter hidden>ロゴを分解する</button>
          <button class="control" type="button" data-motion-toggle>動きを止める</button>
        </div>
      </section>
      <section class="works" id="works" aria-labelledby="works-title">
        <div class="frame">
          <div class="section-head" data-reveal>
            <h2 id="works-title">制作事例</h2>
            <p>目的、使用技術、制作で考えたことを、事例ごとのリポジトリにまとめています。</p>
          </div>
          <div class="case-grid">
            {% for item in cases %}
            <article class="case" data-case data-reveal>
              <div class="case-shell">
                <div class="case-panel">
                  {% if item.image %}
                  <div class="case-image">
                    <img src="/{{ item.image | escape }}" alt="{{ item.title | escape }}の画面" loading="lazy" decoding="async" width="1440" height="900">
                  </div>
                  {% else %}
                  <div class="case-image is-empty" aria-hidden="true">
                    <svg class="case-mark"><use href="#logo-mark"/></svg>
                  </div>
                  {% endif %}
                  <div class="case-body">
                    <p class="case-category">{{ item.category | escape }}</p>
                    <h3 class="case-title"><a href="{{ item.repository | escape }}">{{ item.title | escape }}</a></h3>
                    <p class="case-summary">{{ item.summary | escape }}</p>
                    <p class="case-repo">
                      <span>{{ item.repository | replace("https://github.com/", "") | escape }}</span>
                      <span class="case-arrow" aria-hidden="true">↗</span>
                    </p>
                  </div>
                </div>
              </div>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>
    </main>
    <footer class="footer">
      <div class="frame">
        <nav class="links" aria-label="関連サイト">
          <a class="link" href="https://ak2lab.com/" data-glow data-reveal>
            <span class="link-name">公式サイト</span>
            <span class="link-url">ak2lab.com</span>
            <span class="link-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="link" href="https://github.com/ak2lab" data-glow data-reveal>
            <span class="link-name">GitHub</span>
            <span class="link-url">github.com/ak2lab</span>
            <span class="link-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="link" href="https://x.com/aidev_ak" data-glow data-reveal>
            <span class="link-name">X</span>
            <span class="link-url">@aidev_ak</span>
            <span class="link-arrow" aria-hidden="true">↗</span>
          </a>
        </nav>
        <div class="footer-bottom">
          <a class="brand" href="/">
            <svg class="brand-mark" aria-hidden="true"><use href="#logo-mark"/></svg>
            <span>AK²Lab</span>
          </a>
          <p>自主制作・公開デモを含む制作事例と技術資料を紹介しています。</p>
        </div>
      </div>
    </footer>
    <div class="pointer-light" aria-hidden="true"></div>
  </body>
</html>
